{
  "name": "humex-champions",
  "private": true,
  "version": "1.0.4",
  "type": "module",
  "scripts": {
    "dev:vite": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint --ext .ts,.tsx --fix src/",
    "preview": "vite preview",
    "format": "prettier --write ./src",
    "release": "standard-version",
    "gen-lang-types": "i18next-resources-for-ts interface -i ./src/locales -o ./src/types/resources.d.ts",
    "watch-lang": "nodemon --watch src/locales/en.json --exec \"npm run gen-lang-types\"",
    "dev": "npm-run-all --parallel dev:vite watch-lang"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.0",
    "@fontsource/roboto": "^5.2.5",
    "@hookform/resolvers": "^5.0.1",
    "@mui/icons-material": "^7.0.2",
    "@mui/lab": "^7.0.0-beta.11",
    "@mui/material": "^7.0.2",
    "@mui/x-charts": "^8.0.0",
    "@mui/x-data-grid": "^8.0.0",
    "@mui/x-date-pickers": "^8.0.0",
    "dayjs": "^1.11.13",
    "firebase": "^11.6.0",
    "i18next": "^25.0.1",
    "i18next-resources-for-ts": "^1.6.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-hook-form": "^7.56.0",
    "react-i18next": "^15.4.1",
    "react-imask": "^7.6.1",
    "react-router-dom": "^7.5.1",
    "yup": "^1.6.1"
  },
  "devDependencies": {
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@typescript-eslint/eslint-plugin": "^8.30.1",
    "@typescript-eslint/parser": "^8.30.1",
    "@vitejs/plugin-react": "^4.4.1",
    "eslint": "^9.25.0",
    "eslint-config-prettier": "^10.1.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-prettier": "^5.2.6",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "standard-version": "^9.5.0",
    "typescript": "^5.8.3",
    "vite": "^6.3.2"
  }
}
