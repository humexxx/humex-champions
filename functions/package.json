{
  "name": "functions",
  "scripts": {
    "lint": "eslint --ext .js,.ts .",
    "lint:fix": "eslint --ext .ts,.tsx --fix src/",
    "build": "tsc",
    "build:watch": "tsc --watch",
    "serve": "npm run build && firebase emulators:start --only functions",
    "serve:debug": "npm run build && firebase emulators:start --only functions --inspect-functions",
    "serve:ui": "npm run build && firebase emulators:start --inspect-functions",
    "shell": "npm run build && firebase functions:shell",
    "start": "npm run shell",
    "deploy": "firebase deploy --only functions",
    "deploy:prod": "firebase use prod && firebase deploy --only functions",
    "deploy:dev": "firebase use dev && firebase deploy --only functions",
    "logs": "firebase functions:log",
    "logs:tail": "firebase functions:log --only",
    "test": "npm run build && firebase emulators:exec --only functions 'npm run test:unit'",
    "test:unit": "echo 'Add your test command here'"
  },
  "engines": {
    "node": "18"
  },
  "main": "lib/functions/src/index.js",
  "dependencies": {
    "dayjs": "^1.11.13",
    "firebase-admin": "^13.0.0",
    "firebase-functions": "^6.1.0",
    "module-alias": "^2.2.3",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/module-alias": "^2.0.4",
    "@typescript-eslint/eslint-plugin": "^5.12.0",
    "@typescript-eslint/parser": "^5.12.0",
    "eslint": "^8.9.0",
    "eslint-config-google": "^0.14.0",
    "eslint-plugin-import": "^2.31.0",
    "firebase-functions-test": "^3.1.0",
    "typescript": "^5.6.3"
  },
  "private": true
}
